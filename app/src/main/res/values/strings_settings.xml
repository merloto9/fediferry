    <!-- Templates -->
    <string name="settings_new_template">New template</string>
    <string name="settings_templates_intro">A template is a topic: which hashtags it ticks, and how its posts are written. Bodies can use {tags}, {link}, {date} and the placeholders from Placeholders &amp; sources.</string>
    <string name="settings_what_can_i_use">What can I use?</string>
    <string name="settings_template_name">Name</string>
    <string name="settings_template_body">Body</string>
    <plurals name="settings_template_unknown">
        <item quantity="one">%1$s is not defined, and would be posted exactly as typed.</item>
        <item quantity="other">%1$s are not defined, and would be posted exactly as typed.</item>
    </plurals>
    <string name="settings_add_source_hashtags">Add the source\'s hashtags</string>
    <string name="settings_add_source_hashtags_detail">Ticks whatever a source\'s {tags} recipe in Placeholders &amp; sources gives — 9GAG\'s own tags, say — beside the ones above. Each post can still change it in the editor.</string>
    <string name="settings_default_content_warning">Default content warning</string>
    <string name="settings_default_visibility">Default visibility</string>
    <string name="settings_fixed_description">Fixed description</string>
    <string name="settings_fixed_description_hint">A meme</string>
    <string name="settings_fill_placeholders_from">Fill placeholders from</string>
    <string name="settings_fill_placeholders_detail">For posts from a ticked source, placeholders such as {caption} are filled using their recipes in Placeholders &amp; sources. From an unticked one they stay empty.</string>
    <string name="settings_template_hashtags">Hashtags</string>
    <string name="settings_hashtag_list_empty">The hashtag list is empty — add some in Settings → Hashtags.</string>
    <string name="settings_hashtag_not_listed">%1$s (not on the list)</string>
    <string name="settings_template_hashtags_detail">Ticked ones start ticked in the editor and fill {tags}.</string>

    <!-- Sharing & posting -->
    <string name="settings_resolve_links">Fetch images from shared links</string>
    <string name="settings_resolve_links_detail">When a link is shared on its own, get the image from the service instead of waiting for a screenshot. Works for 9GAG, Pinterest and Reddit; Instagram publishes nothing to fetch.</string>
    <string name="settings_auto_crop">Trim screenshots automatically</string>
    <string name="settings_auto_crop_detail">Post now and Save for later cut a screenshot down to the picture when the detection is confident. The original is kept either way, so the editor can undo it.</string>
    <string name="settings_clean_old_links">Clean older links</string>
    <string name="settings_clean_old_links_detail">Pinterest and Reddit links shared before FediFerry 0.17.1, or added to a post\'s text by hand, may say who shared them. Check every link in the inbox now.</string>
    <string name="settings_check">Check</string>
    <string name="settings_undo_window">Undo window: %1$ds</string>
    <string name="settings_undo_window_detail">How long Post now waits before sending. Zero sends immediately.</string>
    <string name="settings_purge_never">Posted items: kept forever</string>
    <plurals name="settings_purge_after">
        <item quantity="one">Posted items: purged after %d day</item>
        <item quantity="other">Posted items: purged after %d days</item>
    </plurals>

    <!-- Image clean-up -->
    <string name="settings_cleanup_profiles">Cleanup profiles</string>
    <string name="settings_cleanup_intro">Areas to remove from a screenshot, per source. Drawn on the Clean up screen and kept here, so when a layout moves you adjust the rule rather than wait for an update.</string>
    <string name="settings_cleanup_default_intro">The profile marked default is applied on its own to shares that do not stop for input. Leave none default and nothing happens unasked.</string>
    <string name="settings_cleanup_no_profiles">No profiles yet — draw on Clean up in the editor and tick Remember.</string>
    <string name="settings_cleanup_delete_profile">Delete profile</string>
    <string name="settings_cleanup_no_areas">No areas yet</string>
    <string name="settings_cleanup_rule">%1$s · %2$d,%3$d%% → %4$d,%5$d%%</string>
    <string name="settings_cleanup_delete_area">Delete area</string>
    <string name="settings_treatment_fill">fill in</string>
    <string name="settings_treatment_crop_away">crop away</string>
    <string name="settings_treatment_blur">blur</string>
    <string name="settings_treatment_pixelate">pixelate</string>
    <string name="settings_treatment_ai_erase">erase with AI</string>
    <string name="settings_image_model">Image model</string>
    <string name="settings_image_model_intro">Used by the \"Erase with AI\" treatment on the Clean up screen, for overlays that sit on detail where filling from the surroundings only smears. Leave the endpoint empty and that treatment falls back to a local fill.</string>
    <string name="settings_image_model_format">Inpainting has no standard request shape, so the format is a setting rather than a guess. Multipart suits the OpenAI images/edits family; JSON suits the Stable Diffusion derived servers.</string>
    <string name="settings_instruction">Instruction</string>

    <!-- Alt text -->
    <string name="settings_vision_intro">Writes alt text for templates set to Generated. Any OpenAI-compatible chat-completions endpoint whose model can look at images works. The picture is sent there, so pick a service you trust with it. A failure never blocks a post; it goes out without a description instead.</string>
    <string name="settings_prompt">Prompt</string>

    <!-- Diagnostics -->
    <string name="settings_keep_log">Keep a log</string>
    <string name="settings_keep_log_detail">Records what the app does — a share arriving, a link resolving, a post failing — so a problem can be looked at afterwards. Access tokens and post text are never written down.</string>
