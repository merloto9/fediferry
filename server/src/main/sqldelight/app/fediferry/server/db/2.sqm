-- A project's settings — templates, placeholders, hashtags, AI models, clean-up
-- profiles, sources — one row per object, as the JSON the app keeps them in.
-- Every phone mirrors these; the server's copy is the one that counts.
CREATE TABLE settings_entry (
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    kind TEXT NOT NULL,
    id TEXT NOT NULL,
    json TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    updated_by TEXT,
    PRIMARY KEY (project_id, kind, id)
);

-- Secrets of a project (AI keys, channel tokens), encrypted with the server's
-- master key. Never returned by the API.
CREATE TABLE secret (
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    id TEXT NOT NULL,
    ciphertext TEXT NOT NULL,
    nonce TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (project_id, id)
);

-- Where a project publishes: a Mastodon account now, other fediverse
-- software later. What the destination can take is kept in capabilities_json.
CREATE TABLE channel (
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    id TEXT NOT NULL,
    type TEXT NOT NULL,
    name TEXT NOT NULL,
    instance TEXT NOT NULL,
    remote_account_id TEXT NOT NULL,
    acct TEXT NOT NULL,
    display_name TEXT NOT NULL,
    avatar_url TEXT,
    capabilities_json TEXT NOT NULL DEFAULT '{}',
    defaults_json TEXT NOT NULL DEFAULT '{}',
    is_default INTEGER NOT NULL DEFAULT 0,
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (project_id, id)
);

-- The server's own registration with each fediverse instance, per redirect
-- address (the app's debug and release builds differ). Shared by projects.
CREATE TABLE instance_app (
    instance TEXT NOT NULL,
    redirect_uri TEXT NOT NULL,
    client_id TEXT NOT NULL,
    client_secret_ciphertext TEXT NOT NULL,
    client_secret_nonce TEXT NOT NULL,
    scopes TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    PRIMARY KEY (instance, redirect_uri)
);

-- A sign-in in progress: the state a phone carries through the browser.
CREATE TABLE oauth_pending (
    state TEXT NOT NULL PRIMARY KEY,
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    instance TEXT NOT NULL,
    redirect_uri TEXT NOT NULL,
    created_at INTEGER NOT NULL
);
