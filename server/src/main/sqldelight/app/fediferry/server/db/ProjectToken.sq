-- Tokens that open a project. Only a hash is kept: the token itself is shown
-- once, when it is made, and cannot be read back.
CREATE TABLE project_token (
    id TEXT NOT NULL PRIMARY KEY,
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    token_hash TEXT NOT NULL UNIQUE,
    label TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    revoked_at INTEGER
);

insert:
INSERT INTO project_token(id, project_id, token_hash, label, created_at) VALUES (?, ?, ?, ?, ?);

activeByHash:
SELECT * FROM project_token WHERE token_hash = ? AND revoked_at IS NULL;

byId:
SELECT * FROM project_token WHERE id = ?;

byProject:
SELECT * FROM project_token WHERE project_id = ? ORDER BY created_at;

revoke:
UPDATE project_token SET revoked_at = ? WHERE id = ? AND revoked_at IS NULL;
