-- A post: made from library items, edited as a draft, frozen once ready,
-- then scheduled and published to one channel.
CREATE TABLE post (
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    id TEXT NOT NULL,
    stage TEXT NOT NULL,
    version INTEGER NOT NULL DEFAULT 1,
    channel_id TEXT,
    template_id TEXT,
    body TEXT NOT NULL,
    hashtags TEXT NOT NULL DEFAULT '',
    add_source_hashtags INTEGER NOT NULL DEFAULT 1,
    content_warning TEXT,
    visibility TEXT NOT NULL DEFAULT 'PUBLIC',
    source_url TEXT,
    origin TEXT,
    source_fields_json TEXT NOT NULL DEFAULT '{}',
    link_may_identify INTEGER NOT NULL DEFAULT 0,
    final_text TEXT,
    ready_at INTEGER,
    review_folder_id TEXT,
    created_by TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER,
    PRIMARY KEY (project_id, id)
);

CREATE INDEX post_stage ON post(project_id, deleted_at, stage, updated_at);

-- A post's pictures, in order, each with its own alt text.
CREATE TABLE post_media (
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    post_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    asset_id TEXT NOT NULL,
    library_item_id TEXT,
    alt_text TEXT,
    alt_failed INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (project_id, post_id, position)
);

-- Who is editing a post. Expires if the device goes quiet.
CREATE TABLE post_lock (
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    post_id TEXT NOT NULL,
    device_id TEXT NOT NULL,
    device_name TEXT NOT NULL,
    expires_at INTEGER NOT NULL,
    PRIMARY KEY (project_id, post_id)
);
