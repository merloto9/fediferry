    <!-- Source modules (Settings → Placeholders & sources) -->
    <string name="extra_module_ninegag_summary">Fetches the picture or video behind a shared post — animated posts as the video, not a still.</string>
    <string name="extra_field_ninegag_title">The post\'s title — usually the joke itself.</string>
    <string name="extra_field_ninegag_description">The text under the title. Most posts leave it empty.</string>
    <string name="extra_field_ninegag_hashtags">The post\'s tags as hashtags, e.g. #meme #funny.</string>
    <string name="extra_field_ninegag_section">The section or user page the post was made in.</string>
    <string name="extra_field_ninegag_author">The poster\'s 9GAG username.</string>
    <string name="extra_field_ninegag_alt">9GAG\'s own description of the picture.</string>
    <string name="extra_module_pinterest_summary">Fetches a shared pin\'s picture at full size. Video pins are left for a screenshot.</string>
    <string name="extra_field_pinterest_title">The pin\'s title, without the keyword tail Pinterest adds for search engines.</string>
    <string name="extra_field_pinterest_description">The pin\'s description — often Pinterest\'s own stock sentence rather than the pinner\'s.</string>
    <string name="extra_module_reddit_summary">Fetches a shared post\'s picture, a gallery\'s first picture, a GIF as video, or a video with its sound.</string>
