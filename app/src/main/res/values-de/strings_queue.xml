    <string name="queue_cancel_post">Beitrag absagen</string>
    <string name="queue_reconnect_title">@%1$s neu verbinden</string>
    <string name="queue_read_failed_title">Geplante Beiträge von @%1$s nicht lesbar</string>
    <string name="queue_reconnect_text">Um die Beiträge zu zeigen, die Mastodon später veröffentlicht, braucht FediFerry die Erlaubnis, sie zu lesen. Dieses Konto hat sie beim Verbinden nicht erteilt. Planen funktioniert auch ohne.</string>
    <string name="queue_reconnect">Neu verbinden</string>

    <string name="queue_move_title">Verschieben auf</string>
    <string name="queue_move_confirm">Verschieben</string>
    <string name="queue_cancel_title">Diesen Beitrag absagen?</string>
    <string name="queue_cancel_text">Mastodon nimmt ihn aus der Warteschlange und postet ihn nicht. Er lässt sich danach nicht zurückholen.</string>
    <string name="queue_cancel_confirm">Beitrag absagen</string>
    <string name="queue_cancel_keep">Behalten</string>
    <string name="queue_draft_title">Entwurf erstellen?</string>
    <string name="queue_draft_text">FediFerry kopiert diesen Beitrag – Text, Hashtags, Bild und Bildbeschreibung – in einen neuen Entwurf im Eingang. Mastodon kann Text oder Bild eines geplanten Beitrags nicht ändern. Zum Bearbeiten also: Entwurf erstellen, diesen absagen und den Entwurf neu planen, wenn er fertig ist.</string>
    <string name="queue_draft_and_cancel">Entwurf erstellen, diesen absagen</string>
    <string name="queue_draft_and_keep">Entwurf erstellen, diesen behalten</string>
    <string name="queue_drafting_title">Entwurf wird erstellt</string>
    <string name="queue_drafting_detail">Das Bild wird von deinem Server geladen und der Beitrag in den Eingang kopiert.</string>

    <string name="queue_moved">Verschoben auf %1$s</string>
    <string name="queue_cancelled">Abgesagt. Mastodon postet ihn nicht.</string>
    <string name="queue_draft_made_kept">Entwurf erstellt. Er ist im Eingang; der geplante Beitrag bleibt.</string>
    <string name="queue_draft_made_cancelled">Entwurf erstellt und der geplante Beitrag abgesagt. Bearbeite ihn im Eingang.</string>
    <string name="queue_draft_made_not_cancelled">Entwurf erstellt, aber der geplante Beitrag ließ sich nicht absagen: %1$s</string>
    <string name="queue_draft_failed">Entwurf konnte nicht erstellt werden: %1$s</string>
