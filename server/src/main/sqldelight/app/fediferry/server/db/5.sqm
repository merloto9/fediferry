-- Upload schedules: when a channel's posts go out. Slots are weekly wall-clock
-- times on the schedule's own zone, kept as JSON ([{"days":[1,3],"time":"18:00"}]).
CREATE TABLE schedule (
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    id TEXT NOT NULL,
    channel_id TEXT NOT NULL,
    name TEXT NOT NULL,
    timezone TEXT NOT NULL,
    active INTEGER NOT NULL DEFAULT 1,
    slots_json TEXT NOT NULL DEFAULT '[]',
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (project_id, id)
);

-- A post on its way out: one per post. The loop publishes it once publish_after
-- has passed; idempotency_key stays the same for every try.
CREATE TABLE publication (
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    post_id TEXT NOT NULL,
    channel_id TEXT NOT NULL,
    schedule_id TEXT,
    slot_at INTEGER,
    publish_after INTEGER NOT NULL,
    state TEXT NOT NULL,
    attempts INTEGER NOT NULL DEFAULT 0,
    idempotency_key TEXT NOT NULL,
    remote_id TEXT,
    remote_url TEXT,
    failure_code TEXT,
    published_at INTEGER,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (project_id, post_id)
);

CREATE INDEX publication_due ON publication(state, publish_after);
