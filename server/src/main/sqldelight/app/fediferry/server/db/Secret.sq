-- Secrets of a project (AI keys, channel tokens), encrypted with the server's
-- master key. Never returned by the API.
CREATE TABLE secret (
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    id TEXT NOT NULL,
    ciphertext TEXT NOT NULL,
    nonce TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (project_id, id)
);

upsert:
INSERT INTO secret(project_id, id, ciphertext, nonce, updated_at) VALUES (?, ?, ?, ?, ?)
ON CONFLICT(project_id, id) DO UPDATE SET ciphertext = excluded.ciphertext, nonce = excluded.nonce, updated_at = excluded.updated_at;

byId:
SELECT * FROM secret WHERE project_id = ? AND id = ?;

ids:
SELECT id FROM secret WHERE project_id = ? ORDER BY id;

delete:
DELETE FROM secret WHERE project_id = ? AND id = ?;
