-- Upload schedules: when a channel's posts go out. Slots are weekly wall-clock
-- times on the schedule's own zone, kept as JSON ([{"days":[1,3],"time":"18:00"}]).
CREATE TABLE schedule (
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    id TEXT NOT NULL,
    channel_id TEXT NOT NULL,
    name TEXT NOT NULL,
    timezone TEXT NOT NULL,
    active INTEGER NOT NULL DEFAULT 1,
    slots_json TEXT NOT NULL DEFAULT '[]',
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (project_id, id)
);

insert:
INSERT INTO schedule(project_id, id, channel_id, name, timezone, active, slots_json, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

all:
SELECT * FROM schedule WHERE project_id = ? ORDER BY name;

byId:
SELECT * FROM schedule WHERE project_id = ? AND id = ?;

forChannel:
SELECT * FROM schedule WHERE project_id = ? AND channel_id = ? AND active = 1 ORDER BY name;

update:
UPDATE schedule SET channel_id = ?, name = ?, timezone = ?, active = ?, slots_json = ?, updated_at = ? WHERE project_id = ? AND id = ?;

delete:
DELETE FROM schedule WHERE project_id = ? AND id = ?;

deleteForChannel:
DELETE FROM schedule WHERE project_id = ? AND channel_id = ?;
