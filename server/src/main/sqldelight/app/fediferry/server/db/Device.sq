-- The phones (and later other clients) working on a project. A device names
-- itself, so others can see who is editing what.
CREATE TABLE device (
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    id TEXT NOT NULL,
    name TEXT NOT NULL,
    platform TEXT NOT NULL,
    app_version TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    last_seen_at INTEGER NOT NULL,
    PRIMARY KEY (project_id, id)
);

upsert:
INSERT INTO device(project_id, id, name, platform, app_version, created_at, last_seen_at)
VALUES (?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(project_id, id) DO UPDATE SET
    name = excluded.name,
    platform = excluded.platform,
    app_version = excluded.app_version,
    last_seen_at = excluded.last_seen_at;

byId:
SELECT * FROM device WHERE project_id = ? AND id = ?;

byProject:
SELECT * FROM device WHERE project_id = ? ORDER BY last_seen_at DESC;

touch:
UPDATE device SET last_seen_at = ? WHERE project_id = ? AND id = ?;
