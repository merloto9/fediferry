-- A stored file: a picture (later video). Identified within its project by
-- its content hash, so the same picture shared twice is stored once. Never
-- changed: an edit (crop, clean-up) is a new asset that names its parent.
CREATE TABLE media_asset (
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    id TEXT NOT NULL,
    sha256 TEXT NOT NULL,
    mime TEXT NOT NULL,
    width INTEGER,
    height INTEGER,
    bytes INTEGER NOT NULL,
    parent_asset_id TEXT,
    edit_recipe_json TEXT,
    created_at INTEGER NOT NULL,
    PRIMARY KEY (project_id, id),
    UNIQUE (project_id, sha256)
);

-- Folders in the library, nestable.
CREATE TABLE library_folder (
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    id TEXT NOT NULL,
    parent_id TEXT,
    name TEXT NOT NULL,
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (project_id, id)
);

-- One thing in the library: a picture, a link, or later a text. Posts are
-- made from these and can reuse them; the item itself stays as collected.
CREATE TABLE library_item (
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    id TEXT NOT NULL,
    kind TEXT NOT NULL,
    asset_id TEXT,
    title TEXT,
    text TEXT,
    source_url TEXT,
    origin TEXT,
    source_fields_json TEXT NOT NULL DEFAULT '{}',
    link_may_identify INTEGER NOT NULL DEFAULT 0,
    alt_suggestion TEXT,
    folder_id TEXT,
    device_id TEXT,
    captured_at INTEGER NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER,
    PRIMARY KEY (project_id, id)
);

CREATE INDEX library_item_timeline ON library_item(project_id, deleted_at, captured_at);

CREATE TABLE tag (
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    id TEXT NOT NULL,
    name TEXT NOT NULL COLLATE NOCASE,
    created_at INTEGER NOT NULL,
    PRIMARY KEY (project_id, id),
    UNIQUE (project_id, name)
);

CREATE TABLE library_item_tag (
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    item_id TEXT NOT NULL,
    tag_id TEXT NOT NULL,
    PRIMARY KEY (project_id, item_id, tag_id)
);

-- Which share a device already sent, so a retried upload returns the same
-- item instead of making a second.
CREATE TABLE ingest_record (
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    client_share_id TEXT NOT NULL,
    item_id TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    PRIMARY KEY (project_id, client_share_id)
);
