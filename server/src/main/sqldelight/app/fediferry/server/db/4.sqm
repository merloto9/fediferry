-- Folders for ready posts, kept apart from the library's: review is sorted by
-- when and where a post goes, the library by what a picture is.
CREATE TABLE review_folder (
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    id TEXT NOT NULL,
    name TEXT NOT NULL,
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (project_id, id)
);

-- Free labels on posts ("evening", "needs a second look").
CREATE TABLE post_label (
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    post_id TEXT NOT NULL,
    name TEXT NOT NULL,
    PRIMARY KEY (project_id, post_id, name)
);
