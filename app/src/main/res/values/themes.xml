<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FediFerry" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- The share receiver has no UI of its own; it must not flash a window. -->
    <style name="Theme.FediFerry.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
