-- A post: made from a share, edited as a draft, frozen once ready, then
-- scheduled and published to one channel. It lives only until it is out:
-- once published it is deleted, and Mastodon is where it is kept.
CREATE TABLE post (
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    id TEXT NOT NULL,
    stage TEXT NOT NULL,
    version INTEGER NOT NULL DEFAULT 1,
    channel_id TEXT,
    body TEXT NOT NULL,
    hashtags TEXT NOT NULL DEFAULT '',
    add_source_hashtags INTEGER NOT NULL DEFAULT 1,
    content_warning TEXT,
    visibility TEXT NOT NULL DEFAULT 'PUBLIC',
    source_url TEXT,
    origin TEXT,
    source_fields_json TEXT NOT NULL DEFAULT '{}',
    link_may_identify INTEGER NOT NULL DEFAULT 0,
    final_text TEXT,
    ready_at INTEGER,
    review_folder_id TEXT,
    created_by TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (project_id, id)
);

CREATE INDEX post_stage ON post(project_id, stage, updated_at);

insert:
INSERT INTO post(project_id, id, stage, version, channel_id, body, hashtags, add_source_hashtags, content_warning,
    visibility, source_url, origin, source_fields_json, link_may_identify, created_by, created_at, updated_at)
VALUES (?, ?, ?, 1, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

byId:
SELECT * FROM post WHERE project_id = ? AND id = ?;

byStage:
SELECT * FROM post WHERE project_id = ? AND stage = ? ORDER BY updated_at DESC;

update:
UPDATE post SET channel_id = ?, body = ?, hashtags = ?, add_source_hashtags = ?, content_warning = ?, visibility = ?,
    version = version + 1, updated_at = ?
WHERE project_id = ? AND id = ?;

touch:
UPDATE post SET version = version + 1, updated_at = ? WHERE project_id = ? AND id = ?;

delete:
DELETE FROM post WHERE project_id = ? AND id = ?;

-- Frozen: the text as it will be posted is fixed, and only sorting changes from here.
markReady:
UPDATE post SET stage = 'READY', final_text = ?, ready_at = ?, version = version + 1, updated_at = ?
WHERE project_id = ? AND id = ? AND stage = 'DRAFT';

markDraft:
UPDATE post SET stage = 'DRAFT', final_text = NULL, ready_at = NULL, review_folder_id = NULL, version = version + 1, updated_at = ?
WHERE project_id = ? AND id = ? AND stage = 'READY';

setReviewFolder:
UPDATE post SET review_folder_id = ?, updated_at = ? WHERE project_id = ? AND id = ?;

releaseReviewFolder:
UPDATE post SET review_folder_id = NULL, updated_at = :now WHERE project_id = :project AND review_folder_id = :folder;

setStage:
UPDATE post SET stage = ?, version = version + 1, updated_at = ? WHERE project_id = ? AND id = ?;

byStages:
SELECT * FROM post WHERE project_id = ? AND stage IN ? ORDER BY updated_at DESC;

-- Pairing: the latest draft from this device within the window that has only
-- one half — a link waiting for its screenshot, or the other way round.
waitingForPicture:
SELECT * FROM post
WHERE project_id = ? AND created_by = ? AND created_at >= ? AND stage = 'DRAFT' AND source_url IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM post_media m WHERE m.project_id = post.project_id AND m.post_id = post.id)
ORDER BY created_at DESC LIMIT 1;

waitingForLink:
SELECT * FROM post
WHERE project_id = ? AND created_by = ? AND created_at >= ? AND stage = 'DRAFT' AND source_url IS NULL
  AND EXISTS (SELECT 1 FROM post_media m WHERE m.project_id = post.project_id AND m.post_id = post.id)
ORDER BY created_at DESC LIMIT 1;

-- The post that already carries this picture, if any: the same picture shared again.
-- The post with this picture, or with an edit made straight from it (trimmed
-- or cleaned on intake), so the same screenshot shared again is found.
byAsset:
SELECT post.* FROM post JOIN post_media m ON m.project_id = post.project_id AND m.post_id = post.id
LEFT JOIN media_asset a ON a.project_id = m.project_id AND a.id = m.asset_id
WHERE post.project_id = :project AND (m.asset_id = :asset OR a.parent_asset_id = :asset)
ORDER BY post.created_at LIMIT 1;

-- A link joining a draft that had only its picture.
attachLink:
UPDATE post SET source_url = ?, origin = ?, source_fields_json = ?, link_may_identify = ?, body = ?, hashtags = ?,
    version = version + 1, updated_at = ?
WHERE project_id = ? AND id = ?;
