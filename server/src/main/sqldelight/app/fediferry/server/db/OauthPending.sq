-- A sign-in in progress: the state a phone carries through the browser.
CREATE TABLE oauth_pending (
    state TEXT NOT NULL PRIMARY KEY,
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    instance TEXT NOT NULL,
    redirect_uri TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    -- The channel the account is for; null makes a new one.
    channel_id TEXT,
    -- PKCE: sent to the instance with the code, never to a client.
    code_verifier TEXT
);

insert:
INSERT INTO oauth_pending(state, project_id, instance, redirect_uri, created_at, channel_id, code_verifier) VALUES (?, ?, ?, ?, ?, ?, ?);

-- Only a state still fresh: an old one is as good as gone.
take:
SELECT * FROM oauth_pending WHERE state = ? AND project_id = ? AND created_at >= ?;

delete:
DELETE FROM oauth_pending WHERE state = ?;

expire:
DELETE FROM oauth_pending WHERE created_at < ?;
