-- A post on its way out: one per post. The loop publishes it once publish_after
-- has passed; idempotency_key stays the same for every try.
CREATE TABLE publication (
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    post_id TEXT NOT NULL,
    channel_id TEXT NOT NULL,
    schedule_id TEXT,
    slot_at INTEGER,
    publish_after INTEGER NOT NULL,
    state TEXT NOT NULL,
    attempts INTEGER NOT NULL DEFAULT 0,
    idempotency_key TEXT NOT NULL,
    remote_id TEXT,
    remote_url TEXT,
    failure_code TEXT,
    published_at INTEGER,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (project_id, post_id)
);

CREATE INDEX publication_due ON publication(state, publish_after);

upsert:
INSERT OR REPLACE INTO publication(project_id, post_id, channel_id, schedule_id, slot_at, publish_after, state, attempts, idempotency_key,
    remote_id, remote_url, failure_code, published_at, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, 'QUEUED', 0, ?, NULL, NULL, NULL, NULL, ?, ?);

byPost:
SELECT * FROM publication WHERE project_id = ? AND post_id = ?;

delete:
DELETE FROM publication WHERE project_id = ? AND post_id = ?;

-- Slots taken on a channel by posts not yet out (or out already, so a slot is never used twice).
takenSlots:
SELECT slot_at FROM publication WHERE project_id = ? AND channel_id = ? AND slot_at IS NOT NULL AND state != 'FAILED';

-- Every project's posts whose time has come.
due:
SELECT * FROM publication WHERE state = 'QUEUED' AND publish_after <= ? ORDER BY publish_after LIMIT 20;

-- When the soonest queued post is due, to sleep until exactly then.
nextDue:
SELECT MIN(publish_after) FROM publication WHERE state = 'QUEUED';

claim:
UPDATE publication SET state = 'PUBLISHING', attempts = attempts + 1, updated_at = ? WHERE project_id = ? AND post_id = ? AND state = 'QUEUED';

published:
UPDATE publication SET state = 'PUBLISHED', remote_id = ?, remote_url = ?, failure_code = NULL, published_at = ?, updated_at = ?
WHERE project_id = ? AND post_id = ?;

retryLater:
UPDATE publication SET state = 'QUEUED', publish_after = ?, failure_code = ?, updated_at = ? WHERE project_id = ? AND post_id = ?;

failed:
UPDATE publication SET state = 'FAILED', failure_code = ?, updated_at = ? WHERE project_id = ? AND post_id = ?;

-- After a crash: what was being sent goes back in the queue, under the same key.
interrupted:
SELECT * FROM publication WHERE state = 'PUBLISHING';
