-- One row per change, numbered within its project. Clients ask for everything
-- after the last number they saw and fetch what changed.
CREATE TABLE change_log (
    project_id TEXT NOT NULL REFERENCES project(id) ON DELETE CASCADE,
    rev INTEGER NOT NULL,
    type TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    PRIMARY KEY (project_id, rev)
);

insert:
INSERT INTO change_log(project_id, rev, type, entity_id, deleted, created_at) VALUES (?, ?, ?, ?, ?, ?);

since:
SELECT * FROM change_log WHERE project_id = ? AND rev > ? ORDER BY rev LIMIT ?;
